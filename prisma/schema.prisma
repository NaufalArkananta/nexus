// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int      @id @default(autoincrement())
  nama          String
  noHp          String   @unique
  email         String   @unique
  password      String
  provinsi      String
  kabupatenKota String
  kecamatan     String
  desaKelurahan String
  alamat        String?
  kodePos       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital Hospital?
}

model Event {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  startDate DateTime
  endDate   DateTime
  idRs      Int
  fee       Decimal  @db.Decimal(15, 2)
  kuota     Int
  desc      String   @db.Text
  objective String   @db.Text
  photo     String?
  createdBy Int
  createdAt DateTime @default(now())

  hospital Hospital @relation(fields: [idRs], references: [id])

  @@index([idRs])
  @@index([createdBy])
}

model Hospital {
  id                   Int    @id @default(autoincrement())
  userId               Int    @unique
  namaRumahSakit       String
  jenisRumahSakit      String
  kelasTipe            String
  statusKepemilikan    String
  nomorIzinOperasional String @unique

  alamatLengkap String
  provinsi      String
  kabupatenKota String
  kecamatan     String
  desaKelurahan String

  nomorTelepon String
  emailResmi   String @unique
  namaPIC      String
  emailPIC     String
  password     String

  dokumenIzinOperasional String
  persetujuan            Boolean

  statusVerifikasi StatusVerifikasi @default(MENUNGGU)
  event            Event[]
  user             User             @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusVerifikasi {
  MENUNGGU
  DISETUJUI
  DITOLAK
}
